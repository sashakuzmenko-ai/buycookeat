# Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# OpenRouter (AI-меню і розпізнавання чеків) — знадобиться на наступному етапі
OPENROUTER_API_KEY=

# Telegram-бот. Без цих змінних POST /api/telegram/webhook відповідає 503.
# Секрет webhook: 1–256 символів A–Z, a–z, 0–9, _ і -.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Серверний ключ Supabase лише для бота. Новий secret key (sb_secret_…) має пріоритет.
# Legacy service_role використовується, лише якщо SUPABASE_SECRET_KEY порожній.
# Не додавайте префікс NEXT_PUBLIC_: ключ обходить політики доступу.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
